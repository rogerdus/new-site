---
interface Props {
  href: string;
  target?: '_blank' | '_self' | '_parent' | '_top';
  rel?: string;
  class?: string;
}

const { href, target, rel, class: className = '' } = Astro.props;
---

<a
  href={href}
  target={target}
  rel={target === '_blank' ? 'noopener noreferrer' : rel}
  class={`button ${className}`}
>
  <slot />
</a>