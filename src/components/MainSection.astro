---
interface Props {
  main: {
    headings: string[];
    paragraphs: string[];
    button: {
      text: string;
      link: string;
    };
  };
}

const { main } = Astro.props;
---

<section class="hero">
  <h2 class="intro">Hola, soy</h2>
  <h1 class="big-heading name">{main.headings[0]}</h1>
  <h3 class="big-heading subtitle-hero">{main.headings[1]}</h3>
  <div class="description">
    {main.paragraphs.map(p => <p>{p}</p>)}
  </div>
  <div>
    <a href={main.button.link} class="big-button">{main.button.text}</a>
  </div>
</section>

<style>
.hero {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 100vh;
  padding: 0;
}

.intro {
  color: var(--green);
  font-family: var(--font-mono);
  font-size: clamp(var(--fz-sm), 5vw, var(--fz-md));
  font-weight: 400;
  margin: 0 0 30px 4px;
  animation: fadeUp 0.5s var(--easing) 0s both;
}

.name {
  color: var(--lightest-slate);
  animation: fadeUp 0.5s var(--easing) 0.1s both;
}

.subtitle-hero {
  color: var(--slate);
  animation: fadeUp 0.5s var(--easing) 0.2s both;
}

.description {
  margin-top: 25px;
  max-width: 540px;
  animation: fadeUp 0.5s var(--easing) 0.3s both;
}

.hero > div:last-child {
  animation: fadeUp 0.5s var(--easing) 0.4s both;
}

@media (prefers-reduced-motion: reduce) {
  .intro, .name, .subtitle-hero, .description, .hero > div:last-child {
    animation: none;
  }
}

@media (max-height: 700px) and (min-width: 700px) {
  .hero {
    padding-top: var(--nav-height);
    min-height: auto;
  }
}

@media (max-width: 360px) {
  .hero {
    padding-top: var(--nav-height);
    min-height: auto;
  }
}
</style>