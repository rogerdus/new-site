---
interface Props {
  main: {
    headings: string[];
    paragraphs: string[];
    button: {
      text: string;
      link: string;
    };
  };
}

const { main } = Astro.props;
---

<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow"><span class="prompt">~/</span> supervivencia-linux</p>
    <h1 class="big-heading name">Aprende Linux.<br /><span>Sobrevive mejor.</span></h1>
    <h2 class="subtitle-hero">Guías prácticas para entender la terminal, administrar servidores y ganar autonomía.</h2>
    <div class="description">
      {main.paragraphs.slice(0, 1).map(p => <p>{p}</p>)}
    </div>
    <div class="hero-actions">
      <a href="#projects" class="big-button">Explorar guías <span aria-hidden="true">→</span></a>
      <a href="/blog" class="text-link">Leer el blog <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="terminal-card" aria-label="Ejemplo de terminal Linux">
    <div class="terminal-top"><span></span><span></span><span></span><small>bash — supervivencia</small></div>
    <div class="terminal-body">
      <p><span class="terminal-prompt">$</span> whoami</p>
      <p class="terminal-muted">aprendiz-linux</p>
      <p><span class="terminal-prompt">$</span> cat /etc/motd</p>
      <p class="terminal-accent">Bienvenido a tu nueva terminal.</p>
      <p><span class="terminal-prompt">$</span> <span class="cursor">_</span></p>
    </div>
  </div>
</section>

<style>
.hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(320px, 420px);
  align-items: center;
  gap: clamp(40px, 8vw, 120px);
  min-height: 100vh;
  padding: 0;
}

.hero-copy { max-width: 680px; }

.eyebrow {
  color: var(--slate);
  font-family: var(--font-mono);
  font-size: var(--fz-sm);
  margin: 0 0 24px;
}

.prompt, .terminal-prompt, .terminal-accent { color: var(--green); }

.name span { color: var(--green); }

.subtitle-hero {
  max-width: 580px;
  color: var(--light-slate);
  font-size: clamp(20px, 3vw, 30px);
  font-weight: 400;
  line-height: 1.3;
}

.hero-actions { display: flex; align-items: center; gap: 28px; margin-top: 34px; }
.text-link { color: var(--lightest-slate); font-family: var(--font-mono); font-size: var(--fz-sm); }
.text-link span { color: var(--green); margin-left: 5px; }

.terminal-card {
  overflow: hidden;
  border: 1px solid var(--lightest-navy);
  border-radius: 8px;
  background: rgba(2, 12, 27, 0.9);
  box-shadow: 18px 18px 0 rgba(35, 53, 84, 0.18);
  font-family: var(--font-mono);
  font-size: var(--fz-sm);
  animation: fadeUp 0.7s var(--easing) 0.35s both;
}

.terminal-top { display: flex; align-items: center; gap: 7px; padding: 14px 16px; border-bottom: 1px solid var(--lightest-navy); background: var(--light-navy); }
.terminal-top span { width: 8px; height: 8px; border-radius: 50%; background: var(--dark-slate); }
.terminal-top small { margin-left: 8px; color: var(--slate); font-size: 11px; }
.terminal-body { padding: 24px; min-height: 230px; }
.terminal-body p { margin-bottom: 14px; }
.terminal-muted { color: var(--slate); }
.cursor { animation: blink 1s steps(2, start) infinite; }

@keyframes blink { 50% { opacity: 0; } }

@media (max-width: 768px) {
  .hero { grid-template-columns: 1fr; gap: 44px; padding: 120px 0 60px; }
  .terminal-card { width: 100%; }
}

@media (prefers-reduced-motion: reduce) { .terminal-card, .cursor { animation: none; } }

.intro {
  color: var(--green);
  font-family: var(--font-mono);
  font-size: clamp(var(--fz-sm), 5vw, var(--fz-md));
  font-weight: 400;
  margin: 0 0 30px 4px;
  animation: fadeUp 0.5s var(--easing) 0s both;
}

.name {
  color: var(--lightest-slate);
  animation: fadeUp 0.5s var(--easing) 0.1s both;
}

.subtitle-hero {
  color: var(--slate);
  animation: fadeUp 0.5s var(--easing) 0.2s both;
}

.description {
  margin-top: 25px;
  max-width: 540px;
  animation: fadeUp 0.5s var(--easing) 0.3s both;
}

.hero > div:last-child {
  animation: fadeUp 0.5s var(--easing) 0.4s both;
}

@media (prefers-reduced-motion: reduce) {
  .intro, .name, .subtitle-hero, .description, .hero > div:last-child {
    animation: none;
  }
}

@media (max-height: 700px) and (min-width: 700px) {
  .hero {
    padding-top: var(--nav-height);
    min-height: auto;
  }
}

@media (max-width: 360px) {
  .hero {
    padding-top: var(--nav-height);
    min-height: auto;
  }
}
</style>
