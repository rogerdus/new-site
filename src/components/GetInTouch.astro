---
interface Props {
  get_in_touch: {
    title: string;
    paragraphs: string[];
    button: {
      text: string;
      link: string;
    };
  };
}

const { get_in_touch } = Astro.props;
---

<section id="contact">
  <p class="overline numbered-heading reveal" style="transition-delay: 0ms;">¿Qué sigue?</p>
  <h2 class="title reveal" style="transition-delay: 100ms;">{get_in_touch.title}</h2>
  {get_in_touch.paragraphs.map((p, i) => <p class="contact-text reveal" style={`transition-delay: ${200 + i * 100}ms;`}>{p}</p>)}
  <a href={get_in_touch.button.link} class="big-button email-link reveal" style="transition-delay: 300ms;">{get_in_touch.button.text}</a>
</section>

<style>
section#contact {
  max-width: 600px;
  text-align: center;
  margin: 0 auto 100px;
}

@media (max-width: 768px) {
  section#contact { margin: 0 auto 50px; }
}

.title {
  font-size: clamp(40px, 5vw, 60px);
  color: var(--lightest-slate);
  margin: 0 0 20px 0;
}

.contact-text {
  color: var(--slate);
  text-align: center;
}

.email-link {
  margin-top: 50px;
}
</style>