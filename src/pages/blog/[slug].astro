---
import { parseSiteConfig } from "../../config";
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const { title, author, date, description, tags } = entry.data;
const { email, socials } = parseSiteConfig();
const formattedDate = date.toLocaleDateString("es-ES", { year: 'numeric', month: 'long', day: 'numeric' });
---

<BlogPostLayout site_title={`${title} | Supervivencia Linux`} site_description={description} socials={socials} email={email}>
  <main>
    <span class="breadcrumb">
      <span class="arrow">&larr;</span>
      <a href="/blog">Todos los posts</a>
    </span>
    <header class="post-header">
      <h1 class="medium-heading">{title}</h1>
      <p class="subtitle">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {tags && (
          <span class="tags">
            {tags.map(tag => <a href={`/blog`}>#{tag}</a>)}
          </span>
        )}
      </p>
    </header>
    <div class="post-content">
      <Content />
    </div>
  </main>
</BlogPostLayout>

<style>
main {
  max-width: 1000px;
}

.breadcrumb {
  display: flex;
  align-items: center;
  margin-bottom: 50px;
  color: var(--green);
}

.breadcrumb .arrow {
  display: block;
  margin-right: 10px;
  padding-top: 4px;
}

.breadcrumb a {
  font-family: var(--font-mono);
  font-size: var(--fz-sm);
  font-weight: 600;
  line-height: 1.5;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--green);
}

.post-header {
  margin-bottom: 50px;
}

.post-header h1 {
  margin-bottom: 15px;
}

.tags {
  margin-left: 10px;
}

.tags a {
  color: var(--green);
  font-family: var(--font-mono);
  margin-right: 5px;
}

.post-content {
  margin-bottom: 100px;
}

.post-content :global(h2),
.post-content :global(h3),
.post-content :global(h4) {
  margin: 2em 0 1em;
}

.post-content :global(p) {
  margin: 1em 0;
  line-height: 1.5;
  color: var(--light-slate);
}

.post-content :global(ul),
.post-content :global(ol) {
  margin-bottom: 1.5rem;
  padding-left: 2rem;
}

.post-content :global(li) {
  margin-bottom: 0.5rem;
}

.post-content :global(pre) {
  background-color: var(--light-navy);
  border-radius: var(--border-radius);
  padding: 1.25rem;
  overflow-x: auto;
  margin: 1.5rem 0;
}

.post-content :global(code) {
  font-family: var(--font-mono);
  font-size: var(--fz-sm);
}

.post-content :global(pre code) {
  background-color: transparent;
  padding: 0;
}

.post-content :global(blockquote) {
  border-left: 1px solid var(--green);
  padding-left: 1.5rem;
  margin: 1.5rem 0;
}

.post-content :global(a) {
  color: var(--green);
}

.post-content :global(img) {
  border-radius: var(--border-radius);
  margin: 1.5rem 0;
}
</style>