---
import Navbar from './components/Navbar.astro';
import Meta from './components/Meta.astro';
import Sidebars from './components/Sidebars.astro';
import Footer from './components/Footer.astro';
import '../styles/global.css';

interface Props {
	site_title: string;
	site_description: string;
	email: string;
	socials: {
		linkedin: string;
		twitter: string;
		github: string;
	};
	isHome?: boolean;
}

const { site_title, site_description, email, socials, isHome = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<Meta site_title={site_title} site_description={site_description}/>
		<title>{site_title}</title>
	</head>
	<body>
		<a class="skip-link" href="#content">Saltar al contenido</a>
		<Navbar isHome={isHome} />
		<Sidebars email={email} socials={socials} />
		<div id="content">
			<slot />
		</div>
		<Footer socials={socials} />
	</body>
</html>