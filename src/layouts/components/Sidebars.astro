---
interface Props {
  email: string;
  socials: {
    linkedin: string;
    twitter: string;
    github: string;
  };
  isHome?: boolean;
}
const { email, socials, isHome = false } = Astro.props;
---

<div class="side-left">
  <ul class="social-list">
    <li>
      <a href={socials?.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
        </svg>
      </a>
    </li>
    <li>
      <a href={socials?.twitter} target="_blank" rel="noopener noreferrer" aria-label="Twitter">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z" />
        </svg>
      </a>
    </li>
    <li>
      <a href={socials?.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
          <rect x="2" y="9" width="4" height="12" />
          <circle cx="4" cy="4" r="2" />
        </svg>
      </a>
    </li>
  </ul>
</div>

<div class="side-right">
  <a href={`mailto:${email}`}>{email}</a>
</div>

<style>
.side-left, .side-right {
  position: fixed;
  bottom: 0;
  width: 40px;
  z-index: 10;
  color: var(--light-slate);
}

.side-left {
  left: 40px;
}

.side-right {
  right: 40px;
}

@media (max-width: 1080px) {
  .side-left { left: 20px; }
  .side-right { right: 20px; }
}

@media (max-width: 768px) {
  .side-left, .side-right { display: none; }
}

.social-list {
  display: flex;
  flex-direction: column;
  align-items: center;
  list-style: none;
  padding: 0;
  margin: 0;
}

.social-list::after {
  content: '';
  display: block;
  width: 1px;
  height: 90px;
  background-color: var(--light-slate);
}

.social-list li:last-child {
  margin-bottom: 20px;
}

.social-list a {
  display: inline-flex;
  padding: 10px;
  transition: var(--transition);
}

.social-list a:hover,
.social-list a:focus-visible {
  transform: translateY(-3px);
  color: var(--green);
  outline: none;
}

.side-right {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.side-right::after {
  content: '';
  display: block;
  width: 1px;
  height: 90px;
  background-color: var(--light-slate);
  margin-top: 20px;
}

.side-right a {
  display: inline-block;
  writing-mode: vertical-rl;
  letter-spacing: 0.1em;
  font-family: var(--font-mono);
  font-size: var(--fz-xxs);
  line-height: var(--fz-lg);
  margin: 20px auto;
  padding: 10px;
  transition: var(--transition);
}

.side-right a:hover,
.side-right a:focus-visible {
  transform: translateY(-3px);
  color: var(--green);
  outline: none;
}
</style>